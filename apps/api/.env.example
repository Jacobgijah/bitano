# --- Bitano API config ---
PORT=4000

# Postgres (matches docker-compose)
DATABASE_URL=postgres://bitano:bitano@localhost:5432/bitano

# Pricing (indicative — replace with a real price source)
RATE_TZS_PER_BTC=262000000
SPREAD_PCT=0.02

# Quote lock window (seconds)
QUOTE_TTL_SECONDS=90

# Per-transaction limits (TZS)
MIN_TZS=500
MAX_TZS=5000000

# Per-phone daily caps
MAX_TX_PER_DAY=10
MAX_TZS_PER_DAY=2000000

# ClickPesa webhook signing secret (HMAC-SHA256 over the raw body).
# Leave empty locally to skip signature verification (logs a warning).
# NOTE: confirm the exact header name + signing scheme against the ClickPesa sandbox.
CLICKPESA_WEBHOOK_SECRET=

# Collection wait window before a tx is treated as PAYMENT_TIMEOUT (seconds)
PAYMENT_TIMEOUT_SECONDS=600
