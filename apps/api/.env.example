# --- Bitano API config ---
PORT=4000

# Postgres (matches docker-compose)
DATABASE_URL=postgres://bitano:bitano@localhost:5432/bitano

# Pricing (indicative — replace with a real price source)
RATE_TZS_PER_BTC=262000000
SPREAD_PCT=0.02

# Quote lock window (seconds)
QUOTE_TTL_SECONDS=90

# Per-transaction limits (TZS)
MIN_TZS=500
MAX_TZS=5000000

# Per-phone daily caps
MAX_TX_PER_DAY=10
MAX_TZS_PER_DAY=2000000
